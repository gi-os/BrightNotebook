<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Parsed events are mirrored into the phone's own calendar when one exists, and its
         calendars can be imported. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Reminders. USE_EXACT_ALARM is granted at install and is exactly the calendar case
         it exists for; SCHEDULE_EXACT_ALARM covers builds older than 33. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alarms do not survive a reboot; this is what re-arms them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Not for drawing over anything: on 14 this appop is what lets a reminder start the
         alert activity from a broadcast and light the panel. Grant is adb-only on LightOS:
         adb shell appops set com.gios.lightnotebook SYSTEM_ALERT_WINDOW allow -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The day's photographs, read out of MediaStore. Renamed at 33, so both are declared and
      the old one is capped: READ_EXTERNAL_STORAGE on 33+ is silently ignored, which reads as
      a permission that was granted and then did nothing.

      Read-only, and no `WRITE`: filing a photograph against a day stores its uri, it never
      copies, moves or edits the file. Roll owns the picture; this app only points at it.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Steps. A runtime permission, and the only one here the user can grant from a dialog.

      There is no PACKAGE_USAGE_STATS entry below it on purpose: screen time is an *appop*, not a
      permission, so declaring it would achieve nothing — it is granted with
      `adb shell appops set com.gios.lightnotebook GET_USAGE_STATS allow`, which Settings prints.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      Colour. The panel is a full-colour AMOLED and LightOS's monochrome look is the accessibility
      daltonizer, so a photograph opened full screen can show its real colours by switching that
      off for as long as it is up. signature|privileged|development, so it is an adb grant:
      adb shell pm grant com.gios.lightnotebook android.permission.WRITE_SECURE_SETTINGS
      Without it every write is swallowed and photographs simply stay grey.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Android 11 package visibility: without these, the ticket provider is invisible and
      the deep link resolves to nothing, silently. Both entries are for gi-os/LightPass.
    -->
    <queries>
        <package android:name="com.gios.lightpass" />
        <!--
          Roll, which photographs pages for this app. Without the package entry
          `getPackageInfo` throws NameNotFoundException even when Roll is installed, and the
          reroute would silently always fall back to the in-app camera.
        -->
        <package android:name="com.gios.lightcamera" />
        <!-- Roll's starred list, which decides which photograph a planner cell shows. -->
        <provider android:authorities="com.gios.lightcamera.stars" />
        <!-- Where you were, from LightFog: the one app that records a location. -->
        <package android:name="com.gios.lightfog" />
        <provider android:authorities="com.gios.lightfog.stays" />
        <!-- What you listened to, from LightPhono. -->
        <package android:name="com.lightphone.spotify" />
        <provider android:authorities="com.lightphone.spotify.plays" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <provider android:authorities="com.gios.lightpass.passes" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lightpass" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Notebook"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightNotebook">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Notebook"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LightNotebook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                One note per something another app owns: lightnotebook://note/<key>, which
                opens that note and makes it if it does not exist yet. LightChat's contact
                page is the only caller today and asks by the conversation's normalised
                handles.

                DEFAULT only, no BROWSABLE. This filter creates a database row from an
                unauthenticated intent, and BROWSABLE would let any web page do it — for
                the sake of a "tap a lightnotebook:// URL in a browser" case that nothing
                needs. An app calling startActivity with an implicit ACTION_VIEW gets
                CATEGORY_DEFAULT added for it, so LightChat is unaffected.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="lightnotebook" android:host="note" />
            </intent-filter>
        </activity>

        <!-- The box a reminder puts on screen. showWhenLocked + turnScreenOn are what wake
             the panel; an overlay window sits below the keyguard and cannot. -->
        <activity
            android:name=".ui.ReminderAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.LightNotebook.Alert" />

        <!--
          How Roll is handed somewhere to write a photograph. `grantUriPermissions` with a
          path-scoped `capture_paths.xml`, not a blanket export: this is a hole in the app's
          private storage and the notebook's database lives in the same place.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- Hourly refresh of imported calendars. -->
        <receiver
            android:name=".notify.SyncAlarm"
            android:exported="false" />

        <receiver
            android:name=".notify.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
