<!--
  A holiday glyph, drawn to match LightOS's icon set: a 30-unit viewport, one <path>, solid
  fill, no stroke. Outlines close up at the size a month cell gives this, so every one of
  these is a filled silhouette that has to be recognisable at about 12 pixels across.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30.0dp"
    android:height="30.0dp"
    android:viewportWidth="30.0"
    android:viewportHeight="30.0">
    <path
        android:pathData="M9,4 H21 V20 H9 Z M4,20 H26 V24 H4 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
