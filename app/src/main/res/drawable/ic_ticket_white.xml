<!--
  A ticket stub, for films read out of LightPass. Drawn to match LightOS's icon set: a
  30-unit viewport and a solid fill with the notches carved out of the one path, since a
  tinted vector cannot paint a hole in a second colour. Filled rather than outlined
  because at ~19dp in a list row an outline of this shape closes up.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30.0dp"
    android:height="30.0dp"
    android:viewportWidth="30.0"
    android:viewportHeight="30.0">
    <path
        android:pathData="M5,8 H25 A2,2 0 0 1 27,10 V12 A3,3 0 0 0 27,18 V20 A2,2 0 0 1 25,22 H5 A2,2 0 0 1 3,20 V18 A3,3 0 0 0 3,12 V10 A2,2 0 0 1 5,8 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
