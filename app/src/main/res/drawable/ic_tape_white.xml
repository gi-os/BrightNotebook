        android:fillType="evenOdd"
        android:pathData="M4,7 L26,7 A2,2 0 0 1 28,9 L28,21 A2,2 0 0 1 26,23 L4,23 A2,2 0 0 1 2,21 L2,9 A2,2 0 0 1 4,7 Z M10.5,11 A3.5,3.5 0 1 0 10.5,18 A3.5,3.5 0 1 0 10.5,11 Z M19.5,11 A3.5,3.5 0 1 0 19.5,18 A3.5,3.5 0 1 0 19.5,11 Z"
