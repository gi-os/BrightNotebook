<?xml version="1.0" encoding="utf-8"?>
<!--
  The one directory a camera app is granted write access to.

  Scoped to `captures/` rather than to `filesDir`, because a FileProvider path is a hole in
  this app's sandbox and the notebook's database sits in the same private storage. Roll needs
  to write one JPEG; that is all this offers it.
-->
<paths>
    <files-path name="captures" path="captures/" />
    <!--
      And one directory out: the .ics files an entry is shared as. Its own path rather than a
      corner of `captures/`, so each hole in the sandbox is narrow and says what it is for.
      See data/IcsShare.kt.
    -->
    <files-path name="shared" path="shared/" />
</paths>
